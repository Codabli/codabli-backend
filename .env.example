# Modèle de configuration locale. Copier vers .env puis adapter :
#   cp .env.example .env
# Le fichier .env (avec les vraies valeurs) est ignoré par git.

# --- PostgreSQL ---
POSTGRES_DB=codabli_dev
POSTGRES_USER=codabli
POSTGRES_PASSWORD=codabli

# --- Keycloak (console d'administration) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Secret du client Keycloak "codabli-backend" ---
# Valeur de dev par défaut. En vrai : Keycloak > Clients > codabli-backend >
# Credentials > Regenerate, puis reporter la valeur ici.
KEYCLOAK_CLIENT_SECRET=changeme-dev-secret
