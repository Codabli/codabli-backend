# Modèle de configuration locale. Copier vers .env puis adapter :
#   cp .env.example .env
# Le fichier .env (avec les vraies valeurs) est ignoré par git.

# --- PostgreSQL ---
POSTGRES_DB=codabli_dev
POSTGRES_USER=codabli
POSTGRES_PASSWORD=codabli

# Schema dedié, créé par postgres-init (ne pas utiliser public).
POSTGRES_SCHEMA=codabli

# --- Keycloak (console d'administration) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Secret du client Keycloak "codabli-backend" ---
# Valeur de dev par défaut. En vrai : Keycloak > Clients > codabli-backend >
# Credentials > Regenerate, puis reporter la valeur ici.
KEYCLOAK_CLIENT_SECRET=changeme-dev-secret

# --- OVH ENDPOINT ---
OVH_AI_ENDPOINT_API_KEY= secret-OVH

# --- S3 ---
S3_ACCESS_KEY=codabli
S3_SECRET_KEY=codabli
S3_REGION=gra
S3_BUCKET=codabli_bucket
S3_ENDPOINT=http://localhost:9090
S3_PATH_STYLE_ACCESS_ENABLED=true
S3_MAX_FILE_SIZE=500MB
S3_MAX_REQUEST_SIZE=501MB
S3_API_CALL_TIMEOUT=15m
S3_API_CALL_ATTEMPT_TIMEOUT=5m
S3_PRESIGNED_URL_TTL=15m
# Keep false outside controlled local development until an antivirus scanner is configured.
MEDIA_UPLOAD_ALLOW_WITHOUT_ANTIVIRUS=false
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_FIXED_DELAY_MS=60000
MEDIA_ORPHAN_AGE=24h
